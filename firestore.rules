rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(docUid) {
      return isSignedIn() && uid() == docUid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isBuyer()  { return isSignedIn() && userRole() == 'buyer';  }
    function isSeller() { return isSignedIn() && userRole() == 'seller'; }
    function isAdmin()  { return isSignedIn() && userRole() == 'admin';  }

    // ─────────────────────────────────────────────────────────────────────────
    // users — core identity document (1 per Firebase Auth user)
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isOwner(userId) || isAdmin() || true;
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // buyer_profiles — extended buyer details & KYC
    // ─────────────────────────────────────────────────────────────────────────

    match /buyer_profiles/{userId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // seller_profiles — business profile, GST, bank details
    // ─────────────────────────────────────────────────────────────────────────

    match /seller_profiles/{userId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // products — wholesale product catalog
    // ─────────────────────────────────────────────────────────────────────────

    match /products/{productId} {
      // Anyone (including unauthenticated) can browse published products
      allow read: if true;

      // Sellers can create products for themselves; admin can manage all
      allow create: if isSignedIn()
        && (isSeller() || isAdmin());

      // Seller can update only their own product; admin can update any
      allow update: if isSignedIn()
        && (resource.data.sellerId == uid() || isAdmin());

      // Admin only for deletes
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // categories — product categories (admin-managed)
    // ─────────────────────────────────────────────────────────────────────────

    match /categories/{categoryId} {
      allow read:  if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // orders — buyer purchase orders
    // ─────────────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      allow read:   if isSignedIn()
        && (resource.data.buyerId == uid() || resource.data.sellerId == uid() || isAdmin());
      allow create: if isBuyer();
      allow update: if isSignedIn()
        && (resource.data.buyerId == uid() || resource.data.sellerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // carts — active shopping carts (1 cart doc per buyer UID)
    // ─────────────────────────────────────────────────────────────────────────

    match /carts/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // rfqs — Request For Quotation
    // ─────────────────────────────────────────────────────────────────────────

    match /rfqs/{rfqId} {
      allow read:   if isSignedIn()
        && (resource.data.buyerId == uid() || resource.data.sellerId == uid() || isAdmin());
      allow create: if isBuyer();
      allow update: if isSignedIn()
        && (resource.data.buyerId == uid() || resource.data.sellerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // reviews — product reviews & ratings
    // ─────────────────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isBuyer();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // notifications — user notifications
    // ─────────────────────────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.userId == uid();
      allow write:  if isSignedIn() || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // admin_logs — audit trail (admin read-only)
    // ─────────────────────────────────────────────────────────────────────────

    match /admin_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if isAdmin() || isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // otp_codes — ephemeral OTP verification codes (server-side API routes)
    // Server-side Next.js API routes run without Firebase Auth context,
    // so these must be open. Documents are auto-deleted after verification.
    // ─────────────────────────────────────────────────────────────────────────

    match /otp_codes/{docId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Placeholder / _meta documents — allow writes for seeding
    // ─────────────────────────────────────────────────────────────────────────

    match /{collection}/_placeholder {
      allow read, write: if true;
    }
  }
}
